# SERVER
PORT=5000
NODE_ENV=development

# DATABASE
MONGO_URI=mongodb://127.0.0.1:27017/highlightkaro

# AUTH
JWT_SECRET=change-me
# Optional; falls back to JWT_SECRET
JWT_REFRESH_SECRET=

# RAZORPAY (use rzp_test_ keys outside production)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Must match the secret set on the webhook in Razorpay Dashboard
# (URL: <BACKEND_URL>/api/payment/webhook, events: payment_link.paid, payment_link.cancelled, payment_link.expired)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# URLS
# Frontend origin(s), comma-separated. First one is used for payment redirects; all are allowed by CORS.
FRONTEND_URL=http://localhost:5173
# Public URL of this backend; Razorpay redirects to <BACKEND_URL>/api/payment/callback
BACKEND_URL=http://localhost:5000

# Optional: full path to ffmpeg if it is not on PATH
FFMPEG_PATH=
